{
  "name": "ridgeline-racer",
  "version": "0.1.0",
  "private": true,
  "description": "Ridgeline Racer: a 3D circuit racer with four camera views and keyboard, mouse, gamepad and touch controls, built on the GameDNA Kit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vite build && node ../../scripts/copy-licenses.mjs dist three",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "test": "vitest --run --root . --dir tests"
  },
  "dependencies": {
    "@gamedna/kit": "*",
    "three": "0.170.0"
  },
  "devDependencies": {
    "vite": "7.3.8"
  }
}
