{
  "version": "v1",
  "hooks": [
    {
      "name": "Bounded regression after spec tasks",
      "trigger": "PostTaskExec",
      "action": { "type": "command", "command": "node scripts/regression-hook.mjs", "timeout": 180 }
    },
    {
      "name": "Bounded regression when the agent stops",
      "trigger": "Stop",
      "action": { "type": "command", "command": "node scripts/regression-hook.mjs --quiet", "timeout": 180 }
    }
  ]
}
