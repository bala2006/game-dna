{
  "schemaVersion": 1,
  "projectId": "godot-mini",
  "name": "GameDNA Mini (Godot)",
  "engine": {
    "id": "godot",
    "version": "4.7"
  },
  "design": {
    "genre": "conformance-fixture",
    "coreLoop": "Walk right, jump, collect coins",
    "stylePack": "layered-minimal",
    "experienceGoals": ["deterministic"]
  },
  "tuningFile": "tuning.json",
  "viewport": {
    "width": 320,
    "height": 180
  },
  "constraints": [
    {
      "id": "WALK-01",
      "requirementRef": "REQ-1",
      "statement": "Holding right moves the walker walker.speed units every tick"
    },
    {
      "id": "JUMP-01",
      "requirementRef": "REQ-2",
      "statement": "A jump starts only from the ground and only once per press"
    },
    {
      "id": "COIN-01",
      "requirementRef": "REQ-3",
      "statement": "Each coin line counts once, and the coin number only grows"
    }
  ],
  "parameters": {
    "walker.speed": {
      "type": "number",
      "unit": "units/tick",
      "min": 1,
      "max": 10,
      "group": "walker",
      "description": "Distance moved per tick while right is held"
    },
    "walker.jump": {
      "type": "number",
      "unit": "units/tick",
      "min": 2,
      "max": 12,
      "group": "walker",
      "description": "Upward speed at the start of a jump; gravity removes 1 per tick"
    }
  },
  "commands": {
    "headless": {
      "kind": "headless",
      "argv": ["godot", "--headless", "--path", "{project}"]
    },
    "run": {
      "kind": "run",
      "argv": ["godot", "--path", "{project}"]
    }
  }
}
