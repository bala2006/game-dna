    "./camera": "./src/camera.ts",
    "./vehicle": "./src/vehicle.ts",
    "./character": "./src/character.ts",
    "./world": "./src/world.ts",
    "./stage": "./src/stage.ts",
    "./contracts": "./src/contracts.ts",
    "./collision": "./src/collision.ts",
    "./controller": "./src/controller.ts",
    "./handling": "./src/handling.ts",
    "./fsm": "./src/fsm.ts",
    "./behavior": "./src/behavior.ts",
    "./steering": "./src/steering.ts",
    "./nav": "./src/nav.ts",
    "./events": "./src/events.ts",
    "./save": "./src/save.ts",
    "./inventory": "./src/inventory.ts",
    "./rooms": "./src/rooms.ts",
    "./pool": "./src/pool.ts",
    "./budget": "./src/budget.ts",
    "./feedback": "./src/feedback.ts",
    "./dispose": "./src/dispose.ts"
  },
  "peerDependencies": {
    "three": "0.170.0"
