{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "apps/*/scripts/**/*.ts",
    "apps/*/vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "vitest.e2e.config.ts"
  ]
}
